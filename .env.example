# Base de datos (Neon en Vercel / Postgres local en dev)
# Local con Prisma embebido: npm run db:up  ->  copiá la URL que imprime
DATABASE_URL="postgresql://usuario:password@host:5432/igsorteos?sslmode=require"

# Secreto de Auth.js. Generalo con: npx auth secret
AUTH_SECRET=""

# true = datos simulados, sin necesidad de app de Meta.
# false = conexión real con la Instagram Graph API.
AUTH_DEMO_MODE="true"

# Solo cuando AUTH_DEMO_MODE="false". App de https://developers.facebook.com
AUTH_INSTAGRAM_ID=""
AUTH_INSTAGRAM_SECRET=""

# Versión de la Graph API de Meta
META_GRAPH_VERSION="v23.0"

# En producción lo define Vercel automáticamente
AUTH_URL=""
AUTH_TRUST_HOST="true"
